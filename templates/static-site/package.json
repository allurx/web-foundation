{
    "name": "my-site",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "engines": {
        "node": "24.21.0"
    },
    "scripts": {
        "dev": "vite --open --host 0.0.0.0",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint . --max-warnings 0",
        "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
        "check": "npm run format:check && npm run lint && npm run type-check",
        "build": "npm run check && vite build",
        "verify": "npm run build",
        "preview": "wrangler dev",
        "deploy": "wrangler deploy"
    },
    "devDependencies": {
        "@allurx/web-foundation": "git+https://github.com/allurx/web-foundation.git#<RELEASE_TAG>"
    },
    "prettier": "@allurx/web-foundation/prettier"
}
